<nav class="app-nav" role="navigation" aria-label="Main navigation">
  <div class="app-nav-content">
    <a href="/" class="app-nav-logo" aria-label="Home">Invoice Reminders</a>
    <div class="app-nav-links" role="menubar" aria-label="Primary">
      <a href="/" class="app-nav-link" role="menuitem">Home</a>
      <a href="/clients" class="app-nav-link" role="menuitem">Clients</a>
      <a href="/overdue" class="app-nav-link" role="menuitem">Overdue</a>
      <a href="/clients" class="app-nav-link app-nav-cta" role="menuitem">Add Client</a>
    </div>
  </div>
</nav>

<style>
  .app-nav {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: linear-gradient(90deg, #4f46e5, #5e60ce);
    color: white;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .app-nav-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .app-nav-logo {
    color: white;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-decoration: none;
    font-size: 1.1rem;
  }

  .app-nav-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem;
  }

  .app-nav-link {
    color: rgba(255, 255, 255, 0.92);
    background: transparent;
    border: 1px solid transparent;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .app-nav-link:hover,
  .app-nav-link:focus-visible {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.35);
    outline: none;
  }

  .app-nav-cta {
    background: white;
    color: #4f46e5;
    border-color: #ffffff;
  }

  .app-nav-cta:hover,
  .app-nav-cta:focus-visible {
    background: #f8f9ff;
    color: #4338ca;
  }

  .app-nav-link.active {
    border-color: rgba(255, 255, 255, 0.9);
    background: rgba(255, 255, 255, 0.25);
  }

  @media (max-width: 860px) {
    .app-nav-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .app-nav-links {
      width: 100%;
      justify-content: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
    document.querySelectorAll('.app-nav-link').forEach((link) => {
      const linkPath = new URL(link.href, window.location.origin).pathname.replace(/\/$/, '') || '/';
      if (linkPath === currentPath) {
        link.classList.add('active');
      }
    });
  });
</script>
